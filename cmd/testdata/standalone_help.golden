== dac import --help
NAME:
   dac import - Import dashboards from external tools

USAGE:
   dac import [command [command options]]

COMMANDS:
   metabase  Convert a Metabase dashboard to DAC YAML

OPTIONS:
   --help, -h  show help
== dac import metabase --help
NAME:
   dac import metabase - Convert a Metabase dashboard to DAC YAML

USAGE:
   dac import metabase [options]

OPTIONS:
   --input string, -i string       Path to a Metabase dashboard API response JSON/YAML file
   --url string                    Metabase base URL for live import
   --dashboard-id string           Metabase dashboard ID for live import
   --api-key string                Metabase API key (or set METABASE_API_KEY) [$METABASE_API_KEY]
   --session-token string          Metabase session token (or set METABASE_SESSION_TOKEN) [$METABASE_SESSION_TOKEN]
   --connection string, -c string  DAC connection name to set on the generated dashboard
   --output string, -o string      Output YAML path (default: <dir>/<dashboard-slug>.yml; use - for stdout)
   --dir string, -d string         Dashboard definitions directory (default: ".")
   --force                         Overwrite an existing output file
   --strict                        Fail instead of creating placeholders for unsupported Metabase cards
   --semantic                      Generate DAC semantic models for explicit Metabase models/metrics and convert eligible widgets to semantic references
   --semantic-strict               Fail when semantic import cannot represent a Metabase model-backed card semantically
   --semantic-dir string           Directory for generated semantic model files (default: sibling semantic/ next to dashboards/)
   --help, -h                      show help

GLOBAL OPTIONS:
   --config string, -c string       Path to .bruin.yml config file (default: auto-discover)
   --environment string, -e string  Target environment name
   --debug                          Enable debug logging
