{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getbruin.com/schemas/dac/dashboard/v1",
  "title": "Bruin DAC Dashboard",
  "type": "object",
  "required": ["name", "rows"],
  "properties": {
    "schema": {
      "const": "https://getbruin.com/schemas/dac/dashboard/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "connection": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "queries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/query"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "$defs": {
    "filter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["select", "date-range", "date", "number", "text"]
        },
        "multiple": {
          "type": "boolean"
        },
        "default": true,
        "options": {
          "$ref": "#/$defs/filterOptions"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "date" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^(TODAY([+-][0-9]+)?|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "filterOptions": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array"
        },
        "query": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sql": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionRef"
          }
        },
        "metrics": {
          "$ref": "#/$defs/stringList"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticFilter"
          }
        },
        "segments": {
          "$ref": "#/$defs/stringList"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["widgets"],
      "properties": {
        "tab": {
          "type": "string"
        },
        "height": true,
        "widgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/widget"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "widget": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": ["metric", "chart", "table", "text", "divider", "image"]
        },
        "col": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "query": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "items": { "type": "array" }
            }
          },
          "additionalProperties": false
        },
        "metric": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "granularity": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionRef"
          }
        },
        "metrics": {
          "$ref": "#/$defs/stringList"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticFilter"
          }
        },
        "segments": {
          "$ref": "#/$defs/stringList"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "chart": {
          "enum": [
            "line",
            "bar",
            "area",
            "pie",
            "scatter",
            "bubble",
            "combo",
            "histogram",
            "boxplot",
            "funnel",
            "sankey",
            "heatmap",
            "calendar",
            "sparkline",
            "waterfall",
            "xmr",
            "dumbbell",
            "gauge",
            "treemap",
            "radar",
            "candlestick",
            "forest"
          ]
        },
        "x": {
          "$ref": "#/$defs/axisEncoding"
        },
        "y": {
          "$ref": "#/$defs/axisEncoding"
        },
        "y2": {
          "$ref": "#/$defs/axisEncoding",
          "description": "Optional second value axis on the right (line/area/bar/combo). A y-column listed in y2.field plots against the right axis; all others stay on the left. Lets two series on different scales share one chart."
        },
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/valueEncoding"
        },
        "color": {
          "$ref": "#/$defs/colorEncoding"
        },
        "stacked": {
          "type": "boolean"
        },
        "normalized": {
          "type": "boolean"
        },
        "horizontal": {
          "type": "boolean",
          "description": "Bar charts: render horizontal bars. Funnel charts: lay stages left-to-right instead of top-to-bottom."
        },
        "size": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "bins": {
          "type": "integer",
          "minimum": 1
        },
        "showValues": {
          "type": "boolean",
          "description": "Heatmap charts: print each cell's value inside the cell."
        },
        "lines": {
          "$ref": "#/$defs/stringList"
        },
        "series": {
          "$ref": "#/$defs/seriesStyles"
        },
        "yMin": {
          "$ref": "#/$defs/boundEncoding"
        },
        "yMax": {
          "$ref": "#/$defs/boundEncoding"
        },
        "refLines": {
          "type": "array",
          "items": { "$ref": "#/$defs/refLine" }
        },
        "refBands": {
          "type": "array",
          "items": { "$ref": "#/$defs/refBand" }
        },
        "open": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "content": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "dimensionRef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "semanticFilter": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "operator": {
          "enum": ["equals", "not_equals", "gt", "gte", "lt", "lte", "in", "not_in", "between", "is_null", "is_not_null"]
        },
        "value": true,
        "expression": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["dimension", "operator"]
        },
        {
          "required": ["expression"]
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "sort": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["asc", "desc"]
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "tableColumn": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "like": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "align": {
          "enum": ["left", "center", "right"]
        },
        "format": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "$ref": "#/$defs/formatLayer" } }
          ]
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "formatLayer": {
      "type": "object",
      "properties": {
        "if": {
          "enum": [
            "is_empty",
            "is_not_empty",
            "text_contains",
            "text_does_not_contain",
            "text_starts_with",
            "text_ends_with",
            "text_is_exactly",
            "date_is",
            "date_before",
            "date_after",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "is_equal_to",
            "is_not_equal_to",
            "is_between",
            "is_not_between"
          ]
        },
        "value": true,
        "backgroundColor": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "range": { "type": "array", "items": { "type": "number" } },
        "unit": { "enum": ["absolute", "percent", "percentile"] },
        "textColor": {
          "type": "string"
        },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "strikethrough": { "type": "boolean" }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundEncoding": {
      "description": "A CI bound column: a single column name, or a per-series map {series column: bound column} for multi-line charts.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" } }
      ]
    },
    "refLine": {
      "type": "object",
      "required": ["axis", "value"],
      "properties": {
        "axis": { "enum": ["x", "y"] },
        "value": { "type": "number" },
        "label": { "type": "string" },
        "color": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "refBand": {
      "type": "object",
      "required": ["axis", "from", "to"],
      "properties": {
        "axis": { "enum": ["x", "y"] },
        "from": { "type": "number" },
        "to": { "type": "number" },
        "label": { "type": "string" },
        "color": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "axisEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/stringList" }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["date", "number", "category"]
        },
        "title": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "beginAtZero": {
          "type": "boolean"
        },
        "markers": {
          "description": "Show point markers on line/area charts (default true; false hides them).",
          "type": "boolean"
        },
        "curve": {
          "description": "Chart-wide line interpolation every series inherits.",
          "enum": ["smooth", "straight", "stepline"]
        },
        "dash": {
          "description": "Chart-wide dash pattern every series inherits (omitted = solid).",
          "enum": ["solid", "dotted", "dashed", "long-dash"]
        }
      },
      "additionalProperties": false
    },
    "seriesStyles": {
      "description": "Per-series line style overrides keyed by y-column: {column: {color, curve, dash}}. Only stores genuine differences from the chart-wide defaults.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
          "curve": { "enum": ["smooth", "straight", "stepline"] },
          "dash": { "enum": ["solid", "dotted", "dashed", "long-dash"] }
        },
        "additionalProperties": false
      }
    },
    "valueEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["date", "number", "category"]
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "colorEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
