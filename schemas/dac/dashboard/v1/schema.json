{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getbruin.com/schemas/dac/dashboard/v1",
  "title": "Bruin DAC Dashboard",
  "type": "object",
  "required": ["name", "rows"],
  "properties": {
    "schema": {
      "const": "https://getbruin.com/schemas/dac/dashboard/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "connection": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "queries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/query"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "$defs": {
    "filter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["select", "date-range", "date", "number", "text"]
        },
        "multiple": {
          "type": "boolean"
        },
        "default": true,
        "options": {
          "$ref": "#/$defs/filterOptions"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "date" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^(TODAY([+-][0-9]+)?|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "filterOptions": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array"
        },
        "query": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sql": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionRef"
          }
        },
        "metrics": {
          "$ref": "#/$defs/stringList"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticFilter"
          }
        },
        "segments": {
          "$ref": "#/$defs/stringList"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["widgets"],
      "properties": {
        "tab": {
          "type": "string"
        },
        "height": true,
        "widgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/widget"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "widget": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": ["metric", "chart", "table", "text", "divider", "image"]
        },
        "col": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "query": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "items": { "type": "array" }
            }
          },
          "additionalProperties": false
        },
        "metric": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "granularity": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionRef"
          }
        },
        "metrics": {
          "$ref": "#/$defs/stringList"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticFilter"
          }
        },
        "segments": {
          "$ref": "#/$defs/stringList"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "chart": {
          "enum": [
            "line",
            "bar",
            "area",
            "pie",
            "scatter",
            "bubble",
            "combo",
            "histogram",
            "boxplot",
            "funnel",
            "sankey",
            "heatmap",
            "calendar",
            "sparkline",
            "waterfall",
            "xmr",
            "dumbbell",
            "gauge",
            "treemap",
            "radar",
            "candlestick"
          ]
        },
        "x": {
          "$ref": "#/$defs/axisEncoding"
        },
        "y": {
          "$ref": "#/$defs/axisEncoding"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/valueEncoding"
        },
        "color": {
          "$ref": "#/$defs/colorEncoding"
        },
        "stacked": {
          "type": "boolean"
        },
        "normalized": {
          "type": "boolean"
        },
        "horizontal": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "bins": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "$ref": "#/$defs/stringList"
        },
        "yMin": {
          "type": "string"
        },
        "yMax": {
          "type": "string"
        },
        "open": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "content": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "dimensionRef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "semanticFilter": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "operator": {
          "enum": ["equals", "not_equals", "gt", "gte", "lt", "lte", "in", "not_in", "between", "is_null", "is_not_null"]
        },
        "value": true,
        "expression": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["dimension", "operator"]
        },
        {
          "required": ["expression"]
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "sort": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["asc", "desc"]
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "tableColumn": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "colorScale": {
          "$ref": "#/$defs/colorScale"
        },
        "singleColor": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/singleColorRule"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "colorScale": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/colorStop"
        },
        "mid": {
          "$ref": "#/$defs/colorStop"
        },
        "max": {
          "$ref": "#/$defs/colorStop"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "colorStop": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["min", "max", "number", "percent", "percentile"]
            },
            "value": {
              "type": "number"
            },
            "color": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    },
    "singleColorRule": {
      "type": "object",
      "required": ["if"],
      "properties": {
        "if": {
          "enum": [
            "is_empty",
            "is_not_empty",
            "text_contains",
            "text_does_not_contain",
            "text_starts_with",
            "text_ends_with",
            "text_is_exactly",
            "date_is",
            "date_before",
            "date_after",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "is_equal_to",
            "is_not_equal_to",
            "is_between",
            "is_not_between"
          ]
        },
        "value": true,
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "textColor": {
          "type": "string"
        },
        "background": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "axisEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/stringList" }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["date", "number", "category"]
        },
        "title": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "valueEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["date", "number", "category"]
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "colorEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
